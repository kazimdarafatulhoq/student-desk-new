<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>StudentManagement.Desktop.Program</StartupObject>
    <RootNamespace>StudentManagement.Desktop</RootNamespace>
    <AssemblyName>StudentManagement.Desktop</AssemblyName>
    <!-- Helps Visual Studio attach the WinForms designer to SDK-style projects -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>true</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudentManagement.BusinessLayer\StudentManagement.BusinessLayer.csproj" />
    <ProjectReference Include="..\StudentManagement.UserObjects\StudentManagement.UserObjects.csproj" />
    <ProjectReference Include="..\StudentManagement.DataAccessLayer\StudentManagement.DataAccessLayer.csproj" />
    <ProjectReference Include="..\StudentManagement.Reporting\StudentManagement.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Explicit Form / Designer nesting so VS shows Design view -->
  <ItemGroup>
    <Compile Update="Forms\frmLogin.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmLogin.Designer.cs">
      <DependentUpon>frmLogin.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmLogin.resx">
      <DependentUpon>frmLogin.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmMainMenu.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmMainMenu.Designer.cs">
