<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>StudentManagement.Desktop.Program</StartupObject>
    <RootNamespace>StudentManagement.Desktop</RootNamespace>
    <AssemblyName>StudentManagement.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StudentManagement.BusinessLayer\StudentManagement.BusinessLayer.csproj" />
    <ProjectReference Include="..\StudentManagement.UserObjects\StudentManagement.UserObjects.csproj" />
    <ProjectReference Include="..\StudentManagement.DataAccessLayer\StudentManagement.DataAccessLayer.csproj" />
    <ProjectReference Include="..\StudentManagement.Reporting\StudentManagement.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
